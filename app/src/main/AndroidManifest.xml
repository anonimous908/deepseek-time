<?xml version="1.0" encoding="utf-8"?>
<!--
  AndroidManifest.xml — Declaración de componentes del sistema (Application, Activity y AppWidgetProvider).
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      Permiso para programar alarmas exactas en la frontera de tarifa
      (AlarmManager.setExactAndAllowWhileIdle). En Android 12+ (API 31+) garantiza
      que la actualización del widget no se degrade a alarmas inexactas.
    -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />

    <application
        android:name=".DeepseekTimeApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.DeepseekTime">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.DeepseekTime">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          Proveedor del widget de pantalla de inicio.
          Al extender AppWidgetProvider (BroadcastReceiver), recibe también el broadcast
          interno de alarma (ACTION_ALARM) programado en cada transición de tarifa.
          `exported="false"` restringe la interacción a emisiones del propio sistema.
        -->
        <receiver
            android:name=".widget.TariffWidgetProvider"
            android:exported="false"
            android:label="@string/widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info" />
        </receiver>

    </application>

</manifest>
